# Copy this file to ".env" and fill in YOUR real values

# Server
PORT=3000

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password_here
PGDATABASE=donerkebabtacos

# Admin dashboard login (public/admin.html)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Kitchen display PIN (public/kitchen.html)
KITCHEN_PIN=1234
